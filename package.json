{
  "name": "warkentien2-portfolio",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-2.0-only",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev -w @portfolio/web",
    "dev:legacy": "npm run dev -w @portfolio/legacy",
    "build": "npm run build -w @portfolio/web && npm run build -w @portfolio/legacy && node scripts/assemble.mjs",
    "typecheck": "npm run typecheck -w @portfolio/web",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run build && npm test && npm run test:e2e",
    "preview": "node scripts/preview.mjs",
    "evidence:ui": "node scripts/evidence.mjs ui",
    "evidence:ux": "node scripts/evidence.mjs ux"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@axe-core/playwright": "^4.14.0",
    "serve": "^14.2.6"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
